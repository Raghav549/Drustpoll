{
  "expo": {
    "name": "Drustpoll",
    "slug": "drustpoll",
    "owner": "kashyao_07",
    "version": "0.1.0",
    "scheme": "drustpoll",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F6F2",
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "ios": { "supportsTablet": true },
    "android": {
      "package": "com.drustpoll.app",
      "versionCode": 1
    }
  }
}
