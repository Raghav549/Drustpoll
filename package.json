{
  "name": "drustpoll",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node scripts/normalize-rn-086.cjs && expo start",
    "android": "node scripts/normalize-rn-086.cjs && expo start --android",
    "ios": "node scripts/normalize-rn-086.cjs && expo start --ios",
    "web": "node scripts/normalize-rn-086.cjs && expo start --web",
    "typecheck": "node scripts/normalize-rn-086.cjs && tsc --noEmit",
    "doctor": "expo-doctor",
    "build:android:apk": "eas build --platform android --profile apk",
    "build:android:preview": "eas build --platform android --profile preview",
    "eas-build-pre-install": "node scripts/normalize-rn-086.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.17",
    "expo-asset": "~57.0.16",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-image-manipulator": "~57.0.15",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "decode-uri-component": "^0.5.0",
    "postcss": "^8.5.10",
    "uuid": "^11.1.1"
  }
}
